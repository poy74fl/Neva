+// --- Neva : attenuation automatique du retroeclairage RGB (NeoPixel) apres inactivite -----------
+#if ALL(NEOPIXEL_LED, LED_CONTROL_MENU) && defined(NEVA_LED_DIM_TIMEOUT_S) && defined(NEVA_LED_DIM_BRIGHTNESS)
+  #define NEVA_LED_DIM 1
+  #include "../feature/leds/leds.h"
+
+  static millis_t neva_last_activity_ms = 0; // derniere action sur la molette (0 = demarrage)
+  static uint8_t  neva_full_i = 255;         // luminosite normale, memorisee avant attenuation
+  static bool     neva_dimmed = false;
+
+  // Action sur la molette : on remet la luminosite normale
+  static void neva_led_wake(const millis_t ms) {
+    neva_last_activity_ms = ms;
+    if (!neva_dimmed) return;
+    neva_dimmed = false;
+    LEDColor c = leds.color;
+    c.i = neva_full_i;
+    if (leds.lights_on) leds.set_color(c); else leds.color = c;
+  }
+
+  // Appelee regulierement : attenue apres NEVA_LED_DIM_TIMEOUT_S secondes sans action
+  static void neva_led_dim_check(const millis_t ms) {
+    if (wait_for_user) { neva_led_wake(ms); return; }     // message en attente (fin d'impression, changement de filament...) : pleine luminosite
+    if (!leds.lights_on) return;                          // LED eteintes : rien a faire
+    if (leds.color.i <= NEVA_LED_DIM_BRIGHTNESS) return;  // deja aussi sombre que demande
+    // Soit le delai est ecoule, soit un evenement (couleur d'etat) vient de remettre la luminosite
+    if (neva_dimmed || ELAPSED(ms, neva_last_activity_ms + (NEVA_LED_DIM_TIMEOUT_S) * 1000UL)) {
+      neva_full_i = leds.color.i;
+      neva_dimmed = true;
+      LEDColor c = leds.color;
+      c.i = NEVA_LED_DIM_BRIGHTNESS;
+      leds.set_color(c);
+    }
+  }
+#endif
