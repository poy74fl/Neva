+  /**
+   * Neva : test des courroies. Pendant un rapport periodique (M122 S1 P250), on moyenne le StallGuard de X, Y et Z
+   * (mouvements en mouvement seulement) et on l'affiche sur l'ecran : "X180 Y177 Z183 e7%" (e = ecart max entre tours).
+   * M122 S0 affiche le resultat final et le laisse a l'ecran.
+   */
+  #if ALL(TMC_DEBUG, HAS_STALLGUARD, HAS_STATUS_MESSAGE)
+    #define NEVA_BELT_DISPLAY 1
+
+    static uint32_t neva_belt_sum[3];
+    static uint16_t neva_belt_n[3];
+    static millis_t neva_belt_next;
+    static bool neva_belt_busy;   // vrai du lancement du test (menu) jusqu'a son resultat final (M122 S0)
+
+    template<char L, char D>
+    static char neva_axis_letter(const TMCStorage<L, D> &) { return L; }
+
+    static void neva_belt_reset() {
+      for (uint8_t i = 0; i < 3; i++) { neva_belt_sum[i] = 0; neva_belt_n[i] = 0; }
+      neva_belt_next = 0;
+    }
+
+    static void neva_belt_sample(const char axis, const bool ok, const uint16_t sg) {
+      if (!ok || axis < 'X' || axis > 'Z') return;
+      neva_belt_sum[axis - 'X'] += sg;
+      neva_belt_n[axis - 'X']++;
+    }
+
+    // En cours de test, l'ecran n'est rafraichi que toutes les 2 s (un affichage a 4 Hz charge trop la liaison de l'ecran
+    // pendant que les moteurs tournent) ; le resultat final est affiche et aussi envoye sur le port serie.
+    static void neva_belt_show(const bool is_final) {
+      if (!is_final) {
+        const millis_t ms = millis();
+        if (!ELAPSED(ms, neva_belt_next)) return;
+        neva_belt_next = ms + 2000UL;
+      }
+      for (uint8_t i = 0; i < 3; i++) if (!neva_belt_n[i]) return;
+      uint16_t m[3], lo = 0xFFFF, hi = 0;
+      uint32_t tot = 0;
+      for (uint8_t i = 0; i < 3; i++) {
+        m[i] = neva_belt_sum[i] / neva_belt_n[i];
+        if (m[i] < lo) lo = m[i];
+        if (m[i] > hi) hi = m[i];
+        tot += m[i];
+      }
+      const uint16_t spread = tot ? uint16_t(uint32_t(hi - lo) * 300UL / tot) : 0;   // 100 x (max - min) / moyenne
+      char buf[32];
+      sprintf_P(buf, PSTR("X%u Y%u Z%u e%u%%"), (unsigned)m[0], (unsigned)m[1], (unsigned)m[2], (unsigned)spread);
+      ui.set_status(buf, true);
+      if (is_final) SERIAL_ECHO_MSG("Courroies: ", buf);
+    }
+
+    // Appeles par l'ecran dedie (menu_main.cpp) : debut du test (efface les valeurs), fin
+    void neva_belt_begin() { neva_belt_reset(); neva_belt_busy = true; }
+    void neva_belt_end()   { neva_belt_busy = false; }
+
+    // Lecture pour l'ecran dedie (menu_main.cpp) : moyennes X, Y, Z, ecart max en %, nombre de mesures X, rapport actif ?
+    void neva_belt_read(uint16_t m[3], uint16_t &spread, uint16_t &n, bool &running, bool &reporting) {
+      uint16_t lo = 0xFFFF, hi = 0;
+      uint32_t tot = 0;
+      n = neva_belt_n[0];
+      running = neva_belt_busy;
+      reporting = report_tmc_status_interval != 0;
+      for (uint8_t i = 0; i < 3; i++) {
+        m[i] = neva_belt_n[i] ? neva_belt_sum[i] / neva_belt_n[i] : 0;
+        if (!neva_belt_n[i]) n = 0;
+        if (m[i] < lo) lo = m[i];
+        if (m[i] > hi) hi = m[i];
+        tot += m[i];
+      }
+      spread = tot ? uint16_t(uint32_t(hi - lo) * 300UL / tot) : 0;
+    }
+
+    // StallGuard (SG_RESULT) n'est mis a jour que sous le seuil TCOOLTHRS : 0xFFFFF pendant le test, 0 ensuite
+    static void neva_belt_tcool(const uint32_t v) {
